      "parameters": {
        "jsCode": "const entry = $json.body?.entry?.[0];\n\nlet m = null;\nif (entry?.messaging?.[0]) {\n  // real DM format\n  const x = entry.messaging[0];\n  m = { sender: x.sender, recipient: x.recipient, message: x.message };\n} else if (entry?.changes?.[0]?.value) {\n  // Meta test-button format\n  m = entry.changes[0].value;\n}\n\nconst text = m?.message?.text || null;\n\nreturn {\n  json: {\n    senderId: m?.sender?.id || null,\n    recipientId: m?.recipient?.id || null,\n    messageText: text,\n    mid: m?.message?.mid || null,\n    isEcho: !!m?.message?.is_echo,\n    processable: !!text && !m?.message?.is_echo\n  }\n};"
      },
