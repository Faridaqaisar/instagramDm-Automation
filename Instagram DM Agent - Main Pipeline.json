    {
      "parameters": {
        "jsCode": "const aiText = $json.output || $json.text || '';\n\nlet original;\ntry {\n  original = $('Normalize New Contact').item.json;\n} catch (e) {\n  original = $('Normalize Existing Contact').item.json;\n}\n\nconst interested = /\\[INTERESTED:\\s*yes\\]/i.test(aiText);\nconst cleanReply = aiText.replace(/\\[INTERESTED:.*?\\]/i, '').trim();\n\nreturn {\n  json: {\n    contactId: original.contactId,\n    senderId: original.senderId,\n    interested,\n    replyToSend: cleanReply || \"Thanks for your message!\"\n  }\n};"
      },
